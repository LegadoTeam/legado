<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <io.legado.app.ui.widget.text.AccentTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/skip_book_credits"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/rg_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <io.legado.app.lib.theme.view.ThemeRadioNoButton
                android:id="@+id/rb_book"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="5dp"
                android:singleLine="true"
                android:text="@string/audio_skip_scope_book" />

            <io.legado.app.lib.theme.view.ThemeRadioNoButton
                android:id="@+id/rb_global"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="5dp"
                android:singleLine="true"
                android:text="@string/audio_skip_scope_global" />
        </RadioGroup>

        <io.legado.app.ui.widget.DetailSeekBar
            android:id="@+id/open_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:max="180"
            app:title="@string/audio_skip_opening_seconds" />

        <io.legado.app.ui.widget.DetailSeekBar
            android:id="@+id/close_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:max="180"
            app:title="@string/audio_skip_closing_seconds" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
