{
  "name": "legado-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm test && pnpm build-only && pnpm type-check && node ./scripts/sync.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "test": "node --test",
    "type-check": "vue-tsc --build --force",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-svg": "^2.3.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "axios": "^1.19.0",
    "dompurify": "3.4.13",
    "element-plus": "2.14.3",
    "hotkeys-js": "^4.0.4",
    "pinia": "^4.0.2",
    "vue": "^3.5.12",
    "vue-router": "^5.1.0",
    "vue3-virtual-scroll-list": "^0.2.1"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.83.1",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
